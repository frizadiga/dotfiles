{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "color": "#FF0000"
    }
  },
  "default_agent": "plan",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless",
        "--user-data-dir",
        "{env:HOME}/.cache/playwright-profile"
      ]
    },
    "browser-attach": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--cdp-endpoint",
        "http://localhost:9222"
      ]
    }
  },
  "provider": {
    "ollama": {
      "models": {
        "gemma4:e2b": {
          "name": "gemma4:e2b"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OLLAMA_TOKEN_FACTORY_URL}"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow"
  }
}
